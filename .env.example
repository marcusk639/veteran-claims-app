# Copy this file to .env.local and fill in real values.
# .env.local is gitignored -- never commit real secrets.

# Neon Postgres connection string (Task 3).
# Get this from the Neon dashboard: Project > Connection Details.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Clerk publishable key (Task 5).
# Get this from the Clerk dashboard: Configure > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key (Task 5).
# Get this from the Clerk dashboard: Configure > API Keys.
CLERK_SECRET_KEY=sk_test_...

# Required so Clerk's auth.protect() (src/middleware.ts) redirects
# unauthenticated users to this app's own /sign-in page
# (src/app/sign-in/[[...sign-in]]/page.tsx) instead of falling back to
# Clerk's hosted Account Portal (https://<subdomain>.accounts.dev/sign-in).
# Must be set to this exact value -- do not leave unset.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
CLERK_WEBHOOK_SECRET=whsec_...
POSTHOG_API_KEY=phc_...
# rag-system's MCP server HTTP endpoint (Phase 1 Knowledge Assistant).
RAG_MCP_URL=http://localhost:3001/mcp
# Bearer token for the rag-system MCP server (dev: matches its API_TOKENS entry).
RAG_MCP_TOKEN=phase1-connectors-dev-token

# Dollar-based LLM cost alert (Phase 1 Knowledge Assistant, GTM-driven addition).
# Set once real per-message cost data exists -- see the Phase 1 plan's Task 9.
COST_ALERT_THRESHOLD_USD=10.00
COST_ALERT_WEBHOOK_URL=https://example.com/cost-alert-webhook